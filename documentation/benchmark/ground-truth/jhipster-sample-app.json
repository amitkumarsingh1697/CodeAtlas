  "scope": [
    {
      "type": "handled_by",
      "paths": ["src/main/java"],
      "rule": "One relationship per HTTP verb and path declared with a Spring mapping annotation, to the annotated method; class-level @RequestMapping prefix joined; a mapping with several paths gives one relationship per path; no servlet context path."
    },
    {
      "type": "maps_to",
      "paths": ["src/main/java"],
      "rule": "An @Entity class to its own primary table (@Table name, or the default name); @MappedSuperclass classes have no table."
    },
    {
      "type": "reads_table",
      "paths": ["src/main/java"],
      "rule": "A Spring Data repository reads the primary table of its aggregate type argument. A method that runs a query (@Query, EntityManager.createQuery, or a Spring Data derived finder) reads every entity table the query touches: entities named in FROM or JOIN, entities reached by a path join (join fetch a.b, or a.b.c in WHERE), and associations fetched by @EntityGraph. Join tables are excluded. default methods that only call other repository methods are not labelled."
    },
    {
      "type": "writes_table",
      "paths": ["src/main/java"],
      "rule": "A Spring Data repository writes its aggregate table only when it declares or inherits a write method (save, delete)."
    },
    {
      "type": "injects",
      "paths": ["src/main/java"],
      "rule": "A Spring bean (stereotype class, or a @Bean method for its parameters) is given another bean defined in this repository (a stereotype class, a @ConfigurationProperties class or a @Bean method) through its constructor, an @Autowired field or setter, or a @Bean method parameter. Beans that Spring Boot or a library supplies (Environment, CacheManager, JHipsterProperties) are not labelled."
    }
  ],
